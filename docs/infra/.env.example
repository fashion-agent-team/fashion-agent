# 복사해서 .env로 쓰고 값을 채우세요. .env는 절대 커밋하지 않습니다.
APP_ENV=dev                      # dev | prod (prod에서는 /api/v1/auth/dev 꺼짐)

# 공용 DB
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fashion
SPRING_DATASOURCE_USERNAME=fashion
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
REDIS_HOST=redis

# gateway
JWT_SECRET=                      # 32바이트 이상 임의 문자열
FIREBASE_PROJECT_ID=fashion-agent-7631d   # 비밀 값 아님(Firebase 콘솔 프로젝트 ID, 2026-11-05 만듦)
FIREBASE_CREDENTIALS_JSON_BASE64=  # 서비스 계정 JSON을 base64로 (FCM 발송에도 사용)
AGENT_URL=http://agent:8081
SCHEDULE_URL=http://mcp-schedule:8092   # gateway가 /api/v1/schedules/** 를 넘기는 곳
# 엣지 목소리 선희·인준·현수(/api/v1/tts, 2026-11-12, 발표용·비공식). 키 없음. gateway 레포 edge-tts/ 사이드카 주소
EDGE_TTS_URL=                    # 맥북: http://localhost:8099 (edge-tts/에서 python server.py), 젯슨 compose는 자동으로 넣음
# 유진·지민·서현·순복 목소리(/api/v1/tts, 2026-11-12). Azure Speech 무료 등급 F0, 신경망 목소리 한 달 50만 자 무료.
AZURE_SPEECH_KEY=                 # Azure Portal → Speech 리소스(가격 F0) → 키 및 엔드포인트의 키 1
AZURE_SPEECH_REGION=koreacentral  # 그 리소스의 지역
# 구글 목소리(/api/v1/tts, 2026-11-09). Azure 키가 없을 때 씀. 셋 다 비우면 앱은 폰 목소리로 읽음.
GOOGLE_TTS_API_KEY=              # Cloud Text-to-Speech API를 켠 프로젝트의 API 키(Chirp 3 HD, 한 달 100만 자 무료). 먼저 씀
GEMINI_API_KEY=                  # 위가 없을 때 Gemini TTS(무료, 하루 횟수 적음)
OPENAI_API_KEY=                  # gateway 음성 인식(/api/v1/stt, gpt-4o-mini-transcribe, 1분 약 0.003달러). 없으면 폰 음성 인식만
TTS_SPEAKING_RATE=1.0            # 구글 목소리 빠르기(Cloud TTS만). 1.0이 보통

# GPT(OpenAI): agent 판단·도구 선택, closet 답변, clothes-state 비전 폴백에 사용 (Gemini는 쓰지 않음, 2026-11-04)
OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-5.4-mini    # agent 판단 모델 (agent openai 프로필, dev·prod = mcp,openai,redis)
AGENT_OPENAI_REASONING=none        # gpt-5.4-mini는 도구를 쓸 때 none만 받음(2026-11-04 측정)
MCP_WEATHER_URL=http://mcp-weather:8091/mcp
MCP_SCHEDULE_URL=http://mcp-schedule:8092/mcp
MCP_CLOTHES_STATE_URL=http://mcp-clothes-state:8093/mcp
MCP_FACE_CHECK_URL=http://mcp-face-check:8094/mcp
MCP_CLOSET_URL=http://mcp-closet:8095/mcp

# mcp-schedule
KAKAO_REST_API_KEY=

