# cp .env.example .env 후 값 채우기 (커밋 금지, chmod 600)
# --- DB (컨테이너 postgres 비밀번호, 서비스 4개가 같이 씀)
POSTGRES_PASSWORD=
# --- gateway: 32바이트 이상. 비우면 켤 때마다 새로 만들어져 토큰이 무효가 됨
JWT_SECRET=
FIREBASE_PROJECT_ID=
# --- 보안(2026-11-25). 개발용 로그인 키: 앱 폴더 .dev-login-key에도 같은 값을 넣고 앱을 다시 설치
GATEWAY_DEV_LOGIN_KEY=
GATEWAY_SIGNUPS_PER_DAY=300
# 강사님 프록시처럼 X-Forwarded-For를 붙이는 바깥 프록시 주소(쉼표). 사설망·Tailscale은 기본으로 믿음
GATEWAY_TRUSTED_PROXIES=
# agent → MCP 서버 내부 호출 키. 모델 서버 젯슨 .env에도 같은 값
MCP_SHARED_KEY=
# 서버별 DB 계정(scripts/db-roles.sh가 만듦). 비우면 POSTGRES 관리자 계정(fashion)을 씀
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=
SCHEDULE_DB_USER=
SCHEDULE_DB_PASSWORD=
CLOSET_DB_USER=
CLOSET_DB_PASSWORD=
# --- OpenAI (gateway STT/TTS, agent, clothes-state)
OPENAI_API_KEY=
# --- gateway 목소리(선택). 엣지 선희는 키 없이 켜짐. Azure 유진 등을 쓰려면
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
AGENT_OPENAI_MODEL=
AGENT_OPENAI_REASONING=
# --- schedule
KAKAO_REST_API_KEY=
# --- clothes-state: FashionSigLIP. 비우면 끔(메모리 약 400MB 절약)
CLOTHES_EMBED_MODEL=/models/marqo-fashionSigLIP-vision.onnx
# --- Cloudflare Tunnel (선택, --profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
