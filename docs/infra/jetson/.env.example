# cp .env.example .env 후 값 채우기 (커밋 금지, chmod 600)
# --- DB (컨테이너 postgres 비밀번호, 서비스 4개가 같이 씀)
POSTGRES_PASSWORD=
# --- gateway: 32바이트 이상. 비우면 켤 때마다 새로 만들어져 토큰이 무효가 됨
JWT_SECRET=
FIREBASE_PROJECT_ID=
# --- OpenAI (gateway STT/TTS, agent, clothes-state)
OPENAI_API_KEY=
# --- gateway 목소리(선택). 엣지 선희는 키 없이 켜짐. Azure 유진 등을 쓰려면
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
AGENT_OPENAI_MODEL=
AGENT_OPENAI_REASONING=
# --- schedule
KAKAO_REST_API_KEY=
# --- clothes-state: FashionSigLIP. 비우면 끔(메모리 약 400MB 절약)
CLOTHES_EMBED_MODEL=/models/marqo-fashionSigLIP-vision.onnx
# --- helper
HELPER_PUBLIC_BASE_URL=https://simcheong.java21.net
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
SMS_SERVICE_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# --- Cloudflare Tunnel (선택, --profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
